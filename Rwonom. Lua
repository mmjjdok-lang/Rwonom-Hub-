			hit.Size = UDim2.new(1, -12, 0, 28)
			hit.ZIndex = 12
			hit.Parent = row

			local value = default
			local function updateVisual(v)
				local rel = (v - min) / math.max(max - min, 1e-6)
				fill.Size = UDim2.new(rel, 0, 1, 0)
				knob.Position = UDim2.new(rel, 0, 0.5, 0)
				valueLabel.Text = tostring(math.floor(v * 100 + 0.5) / 100) .. suffix
			end
			updateVisual(default)

			local function fireCallback()
				if callback then
					task.spawn(function()
						local ok, err = pcall(callback, value)
						if not ok then warn("[ProUI Slider Error]", err) end
					end)
				end
			end

			makeSingleTouchDraggable(hit, function(inputPos)
				local trackPos, trackWidth = track.AbsolutePosition.X, math.max(track.AbsoluteSize.X, 1)
				local rel = math.clamp((inputPos.X - trackPos) / trackWidth, 0, 1)
				local raw = min + (max - min) * rel
				local newValue = math.clamp(math.floor(raw / speed + 0.5) * speed, min, max)
				newValue = math.floor(newValue * 1e6 + 0.5) / 1e6
				if newValue == value then return end
				value = newValue
				updateVisual(value)
				fireCallback()
			end, function() page.ScrollingEnabled = false end,
			   function() page.ScrollingEnabled = true end)

			local obj = {
				Set = function(_, v, silent)
					value = math.clamp(tonumber(v) or min, min, max)
					updateVisual(value)
					if not silent then fireCallback() end
				end,
				Get = function() return value end,
			}
			return attachCommon(obj, row, flag)
		end

