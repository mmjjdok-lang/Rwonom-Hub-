			keyBtn.Parent = row
			round(keyBtn, UDim.new(0, 8))
			stroke(keyBtn, accent, 1, 0.6)
			applyPressEffect(keyBtn, 0.93)

			local listening = false
			local function show()
				keyBtn.Text = listening and "..." or (key and key.Name or T("none"))
			end
			show()

			local function toggleListening()
				listening = not listening
				show()
			end
			keyBtn.MouseButton1Click:Connect(toggleListening)
			keyBtn.TouchTap:Connect(toggleListening)

			local conn = UserInputService.InputBegan:Connect(function(input, gp)
				if listening then
					if input.UserInputType == Enum.UserInputType.Keyboard then
						listening = false
						if input.KeyCode == Enum.KeyCode.Backspace then
							key = nil
						elseif input.KeyCode ~= Enum.KeyCode.Escape then
							key = input.KeyCode
						end
						show()
						if changed then pcall(changed, key) end
					end
					return
				end
				if gp or not key then return end
				if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key then
					if callback then
						local ok, err = pcall(callback, key)
						if not ok then warn("[ProUI Keybind Error]", err) end
					end
				end
			end)
			row.Destroying:Connect(function() conn:Disconnect() end)

			local obj = {
				Get = function() return key end,
				Set = function(_, k)
					key = toKeyCode(k)
					show()
					if changed then pcall(changed, key) end
				end,
			}
			return attachCommon(obj, row, flag)
		end

