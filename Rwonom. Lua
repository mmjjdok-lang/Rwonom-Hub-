local function tween(obj, info, props)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

local function round(obj, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = radius or UDim.new(0, 10)
	c.Parent = obj
	return c
end

local function stroke(obj, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.5
	s.Parent = obj
	return s
end

local function createRipple(parentButton, inputPos)
	local absPos, absSize = parentButton.AbsolutePosition, parentButton.AbsoluteSize
	local ripple = Instance.new("Frame")
	ripple.BackgroundColor3 = Color3.new(1, 1, 1)
	ripple.BackgroundTransparency = 0.55
	ripple.BorderSizePixel = 0
	ripple.ZIndex = parentButton.ZIndex + 5
	ripple.AnchorPoint = Vector2.new(0.5, 0.5)
	round(ripple, UDim.new(1, 0))

	local relX, relY = 0.5, 0.5
	if inputPos then
		relX = (inputPos.X - absPos.X) / math.max(absSize.X, 1)
		relY = (inputPos.Y - absPos.Y) / math.max(absSize.Y, 1)
	end
	ripple.Position = UDim2.new(relX, 0, relY, 0)
	ripple.Size = UDim2.new(0, 0, 0, 0)
	ripple.Parent = parentButton

	local maxDiameter = math.sqrt(absSize.X ^ 2 + absSize.Y ^ 2) * 2
	local t = tween(ripple, TweenInfo.new(0.55, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, maxDiameter, 0, maxDiameter), BackgroundTransparency = 1,
	})
	t.Completed:Connect(function() ripple:Destroy() end)
end

local function applyPressEffect(button, shrinkScale)
	shrinkScale = shrinkScale or 0.92
	local originalSize = button.Size
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			tween(button, EASE_FAST, {
				Size = UDim2.new(originalSize.X.Scale * shrinkScale, originalSize.X.Offset * shrinkScale,
					originalSize.Y.Scale * shrinkScale, originalSize.Y.Offset * shrinkScale)
			})
			local pos = nil
			pcall(function() pos = input.Position end)
			createRipple(button, pos)
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			tween(button, EASE_BOUNCE, { Size = originalSize })
		end
	end)
end

local function animateGradient(gradient, colorSequences, cycleTime)
	cycleTime = cycleTime or 4
	task.spawn(function()
		local index = 1
		while gradient.Parent do
			local nextIndex = index % #colorSequences + 1
			local startSeq, endSeq = colorSequences[index], colorSequences[nextIndex]
			local proxy = Instance.new("NumberValue")
			proxy.Value = 0
			local conn
			conn = proxy:GetPropertyChangedSignal("Value"):Connect(function()
				local a = proxy.Value
				local kps = {}
				for i, kp in ipairs(startSeq.Keypoints) do
					local endKp = endSeq.Keypoints[i]
					table.insert(kps, ColorSequenceKeypoint.new(kp.Time, kp.Value:Lerp(endKp.Value, a)))
				end
				gradient.Color = ColorSequence.new(kps)
			end)
			tween(proxy, TweenInfo.new(cycleTime, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Value = 1 }).Completed:Wait()
			conn:Disconnect()
			proxy:Destroy()
			index = nextIndex
		end
	end)
end

local function clampFrameToScreen(frame, absX, absY)
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local size = frame.AbsoluteSize
	return math.clamp(absX, 0, math.max(viewport.X - size.X, 0)), math.clamp(absY, 0, math.max(viewport.Y - size.Y, 0))
end

-- سحب دقيق بإصبع واحد فقط (يستخدم للسلايدر ومنتقي الألوان أيضاً)
local function makeSingleTouchDraggable(hitArea, onUpdate)
	local activeInput = nil
	hitArea.InputBegan:Connect(function(input)
		local isPointer = input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
		if not isPointer or activeInput ~= nil then return end
		activeInput = input
		onUpdate(input.Position)
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End and activeInput == input then activeInput = nil end
		end)
	end)
	UserInputService.InputChanged:Connect(function(input)
		if activeInput ~= input then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			onUpdate(input.Position)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if activeInput == input then activeInput = nil end
	end)
end

local function hexToColor3(hex)
	hex = hex:gsub("#", "")
	if #hex ~= 6 then return nil end
	local r = tonumber(hex:sub(1, 2), 16)
	local g = tonumber(hex:sub(3, 4), 16)
	local b = tonumber(hex:sub(5, 6), 16)
	if not (r and g and b) then return nil end
	return Color3.fromRGB(r, g, b)
end

local function color3ToHex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function nearestColorName(c)
	local bestName, bestDist = "Custom", math.huge
	for name, col in pairs(NAMED_COLORS) do
		local d = (col.R - c.R) ^ 2 + (col.G - c.G) ^ 2 + (col.B - c.B) ^ 2
		if d < bestDist then bestDist, bestName = d, name end
	end
	return bestName:sub(1, 1):upper() .. bestName:sub(2)
end

