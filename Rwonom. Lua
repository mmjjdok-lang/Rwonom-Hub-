-- يحدد نوع الأيقونة ويرجع {Type="Image"|"Text", Value=...}
local function resolveIcon(name)
	if name == nil or name == "" then return nil end
	local s = tostring(name)
	if s:match("^rbxassetid://") or s:match("^rbxthumb://") then
		return { Type = "Image", Value = s }
	end
	local key = s:lower():gsub("[%s_]+", "-")
	if LUCIDE_ICONS[key] then
		return { Type = "Text", Value = LUCIDE_ICONS[key] }
	end
	return { Type = "Text", Value = s } -- اسم غير معروف أو إيموجي/حرف مرره المستخدم مباشرة
end

-- ينشئ عنصر أيقونة (صورة أو نص) بحجم ولون محددين
local function createIconElement(parent, iconSpec, size, color)
	if not iconSpec then return nil end
	if iconSpec.Type == "Image" then
		local img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Image = iconSpec.Value
		img.ImageColor3 = color or Color3.new(1, 1, 1)
		img.Size = UDim2.new(0, size, 0, size)
		img.Parent = parent
		return img
	else
		local lbl = Instance.new("TextLabel")
		lbl.BackgroundTransparency = 1
		lbl.Text = iconSpec.Value
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = size
		lbl.TextColor3 = color or Color3.new(1, 1, 1)
		lbl.Size = UDim2.new(0, size + 4, 0, size + 4)
		lbl.TextXAlignment = Enum.TextXAlignment.Center
		lbl.TextYAlignment = Enum.TextYAlignment.Center
		lbl.Parent = parent
		return lbl
	end
end

