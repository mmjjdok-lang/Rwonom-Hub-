function Library.SaveConfig(name, ...)
	if name == Library then name = ... end
	name = tostring(name or "default")
	if not (writefile and makefolder) then return false, "executor has no file API" end
	local data = {}
	for flag, obj in pairs(Flags) do
		if obj.Get then
			local ok, val = pcall(obj.Get, obj)
			if ok and val ~= nil then data[flag] = encodeValue(val) end
		end
	end
	local ok, err = pcall(function()
		if not isfolder("ProUI") then makefolder("ProUI") end
		if not isfolder(CONFIG_DIR) then makefolder(CONFIG_DIR) end
		writefile(CONFIG_DIR .. "/" .. name .. ".json", HttpService:JSONEncode(data))
	end)
	return ok, err
end

function Library.LoadConfig(name, ...)
	if name == Library then name = ... end
	name = tostring(name or "default")
	if not (readfile and isfile) then return false, "executor has no file API" end
	local path = CONFIG_DIR .. "/" .. name .. ".json"
	local okExists, exists = pcall(isfile, path)
	if not (okExists and exists) then return false, "config not found" end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok or type(data) ~= "table" then return false, "invalid config" end
	for flag, raw in pairs(data) do
		local obj = Flags[flag]
		if obj and obj.Set then
			local val = decodeValue(raw)
			if val ~= nil then
				local okSet, errSet = pcall(obj.Set, obj, val)
				if not okSet then warn("[ProUI Config] " .. flag .. ":", errSet) end
			end
		end
	end
	return true
end

function Library.ListConfigs()
	local result = {}
	if not (listfiles and isfolder) then return result end
	pcall(function()
		if not isfolder(CONFIG_DIR) then return end
		for _, path in ipairs(listfiles(CONFIG_DIR)) do
			local fileName = tostring(path):match("([^/\\]+)%.json$")
			if fileName then table.insert(result, fileName) end
		end
	end)
	return result
end

