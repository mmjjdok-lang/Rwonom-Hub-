        -- ------------- مفتاح (Toggle) -------------
        function Tab:CreateToggle(tcfg)
            tcfg = tcfg or {}
            local state = tcfg.Default or false
            local Row = New("Frame", {
                Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Parent = Content,
            })
            New("TextLabel", {
                Size = UDim2.new(1, -50, 1, 0), BackgroundTransparency = 1,
                Text = tcfg.Name or "Toggle", TextColor3 = Colors.White, Font = Enum.Font.Gotham,
                TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = Row,
            })
            local Switch = New("Frame", {
                Size = UDim2.fromOffset(40, 20), Position = UDim2.new(1, -40, 0.5, -10),
                BackgroundColor3 = Colors.Gray, Parent = Row,
            }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
            local Knob = New("Frame", {
                Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(2, 2),
                BackgroundColor3 = Colors.White, Parent = Switch,
            }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

            local function apply(animate)
                local knobPos = state and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)
                local col = state and theme or Colors.Gray
                if animate then
                    Tween(Knob, { Position = knobPos }, 0.15)
                    Tween(Switch, { BackgroundColor3 = col }, 0.15)
                else
                    Knob.Position = knobPos
                    Switch.BackgroundColor3 = col
                end
            end
            apply(false)

            local Click = New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Parent = Row })
            Click.MouseButton1Click:Connect(function()
                PlayClick()
                state = not state
                apply(true)
                if tcfg.Callback then pcall(tcfg.Callback, state) end
            end)
            return { Set = function(_, v) state = v; apply(true) end }
        end

        -- ------------- سلايدر (Slider) -------------
        function Tab:CreateSlider(scfg)
            scfg = scfg or {}
            local min, max = scfg.Min or 0, scfg.Max or 100
            local value = scfg.Default or min

            local Row = New("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, Parent = Content })
            local Label = New("TextLabel", {
                Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1,
                Text = (scfg.Name or "Slider") .. ": " .. tostring(value),
                TextColor3 = Colors.White, Font = Enum.Font.Gotham, TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left, Parent = Row,
            })
            local Track = New("Frame", {
                Size = UDim2.new(1, 0, 0, 8), Position = UDim2.new(0, 0, 0, 22),
                BackgroundColor3 = Colors.Gray, Parent = Row,
            }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
            local Fill = New("Frame", {
                Size = UDim2.fromScale((value - min) / (max - min), 1),
                BackgroundColor3 = theme, Parent = Track,
            }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
            local Handle = New("Frame", {
                Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
                BackgroundColor3 = Colors.White, Parent = Track,
            }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

            local function set(rel)
                value = math.floor(min + rel * (max - min))
                Fill.Size = UDim2.fromScale(rel, 1)
                Handle.Position = UDim2.new(rel, 0, 0.5, 0)
                Label.Text = (scfg.Name or "Slider") .. ": " .. tostring(value)
                if scfg.Callback then pcall(scfg.Callback, value) end
            end
            MakeAxisDraggable(Handle, Track, set)
            return { Set = function(_, v) set(math.clamp((v - min) / (max - min), 0, 1)) end }
        end

