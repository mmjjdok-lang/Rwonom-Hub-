		descLbl.AutomaticSize = Enum.AutomaticSize.Y
		descLbl.ZIndex = 102
		descLbl.Parent = card

		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, 2)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = card
		titleLbl.LayoutOrder, textLbl.LayoutOrder, descLbl.LayoutOrder = 1, 2, 3
		textLbl.Position, textLbl.Size = UDim2.new(), UDim2.new(1, 0, 0, 0)
