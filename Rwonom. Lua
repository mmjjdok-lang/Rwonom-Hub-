			cancelBtn.TextColor3 = Color3.new(1, 1, 1)
			cancelBtn.AutoButtonColor = false
			cancelBtn.BackgroundColor3 = COLOR_OFF
			cancelBtn.Position = UDim2.new(1, -114, 1, -42)
			cancelBtn.Size = UDim2.new(0, 100, 0, 28)
			cancelBtn.ZIndex = 61
			cancelBtn.Parent = popup
			round(cancelBtn, UDim.new(0, 8))
			applyPressEffect(cancelBtn, 0.9)

			local function currentColor() return Color3.fromHSV(h, s, v) end
			local function refreshUI()
				svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
				hexBox.Text = color3ToHex(currentColor())
				nameLbl.Text = T("nearest_color") .. ": " .. nearestColorName(currentColor())
			end

			makeSingleTouchDraggable(svBox, function(inputPos)
				local pos, size = svBox.AbsolutePosition, svBox.AbsoluteSize
				s = math.clamp((inputPos.X - pos.X) / size.X, 0, 1)
				v = math.clamp(1 - (inputPos.Y - pos.Y) / size.Y, 0, 1)
				svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
				refreshUI()
			end)
			makeSingleTouchDraggable(hueStrip, function(inputPos)
				local pos, size = hueStrip.AbsolutePosition, hueStrip.AbsoluteSize
				h = math.clamp((inputPos.Y - pos.Y) / size.Y, 0, 1)
				hueKnob.Position = UDim2.new(0.5, 0, h, 0)
				refreshUI()
			end)

			hexBox.FocusLost:Connect(function()
				local c = hexToColor3(hexBox.Text)
				if c then
					h, s, v = Color3.toHSV(c)
					svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
					hueKnob.Position = UDim2.new(0.5, 0, h, 0)
					refreshUI()
				end
			end)

			local function openPicker()
				openPopupCount = openPopupCount + 1
				popup.Position = UDim2.new(0.5, 0, 0.5, 0)
				popup.Visible = true
				popup.Size = UDim2.new(0, 0, 0, 0)
				tween(popup, EASE_BOUNCE, { Size = UDim2.new(0, POPUP_W, 0, POPUP_H) })
			end
			local function closePicker()
				openPopupCount = math.max(openPopupCount - 1, 0)
				local t = tween(popup, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(0, 0, 0, 0) })
				t.Completed:Connect(function() popup.Visible = false end)
			end

			swatch.MouseButton1Click:Connect(openPicker)
			swatch.TouchTap:Connect(openPicker)
			cancelBtn.MouseButton1Click:Connect(closePicker)
			cancelBtn.TouchTap:Connect(closePicker)

			local function fireCallback(c)
				if callback then
					local ok, err = pcall(callback, c)
					if not ok then warn("[ProUI ColorPicker Error]", err) end
				end
			end

			local function confirmPick()
				local c = currentColor()
				swatch.BackgroundColor3 = c
				closePicker()
				fireCallback(c)
			end
			startBtn.MouseButton1Click:Connect(confirmPick)
			startBtn.TouchTap:Connect(confirmPick)

			local obj = {
				Get = function() return swatch.BackgroundColor3 end,
				Set = function(_, c, silent)
					c = resolveColor(c, nil)
					if not c then return end
					h, s, v = Color3.toHSV(c)
					svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
					hueKnob.Position = UDim2.new(0.5, 0, h, 0)
					refreshUI()
					swatch.BackgroundColor3 = c
					if not silent then fireCallback(c) end
				end,
			}
