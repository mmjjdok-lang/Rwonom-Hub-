			round(row, UDim.new(0, 10))

			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Text = name
			label.Font = Enum.Font.Gotham
			label.TextSize = 14
			label.TextColor3 = Color3.new(1, 1, 1)
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Position = UDim2.new(0, 12, 0, 6)
			label.Size = UDim2.new(1, -70, 0, 18)
			label.ZIndex = 8
			label.Parent = row

			if desc and desc ~= "" then
				local descLbl = Instance.new("TextLabel")
				descLbl.BackgroundTransparency = 1
				descLbl.Text = desc
				descLbl.Font = Enum.Font.Gotham
				descLbl.TextSize = 11
				descLbl.TextColor3 = Color3.fromRGB(210, 210, 220)
				descLbl.TextXAlignment = Enum.TextXAlignment.Left
				descLbl.Position = UDim2.new(0, 12, 0, 26)
				descLbl.Size = UDim2.new(1, -70, 0, 18)
				descLbl.ZIndex = 8
				descLbl.Parent = row
			end

			local pill = Instance.new("TextButton")
			pill.Text = ""
			pill.AutoButtonColor = false
			pill.BackgroundColor3 = COLOR_OFF
			pill.AnchorPoint = Vector2.new(1, 0.5)
			pill.Position = UDim2.new(1, -12, 0.5, 0)
			pill.ZIndex = 8
			pill.Parent = row

			local knob, checkMark
			if isCheck then
				pill.Size = UDim2.new(0, 24, 0, 24)
				round(pill, UDim.new(0, 7))
				checkMark = Instance.new("TextLabel")
				checkMark.BackgroundTransparency = 1
				checkMark.Text = "✓"
				checkMark.Font = Enum.Font.GothamBold
				checkMark.TextSize = 16
				checkMark.TextColor3 = Color3.new(1, 1, 1)
				checkMark.TextTransparency = 1
				checkMark.Size = UDim2.new(1, 0, 1, 0)
				checkMark.ZIndex = 9
				checkMark.Parent = pill
			else
				pill.Size = UDim2.new(0, 46, 0, 24)
				round(pill, UDim.new(1, 0))
				knob = Instance.new("Frame")
				knob.BackgroundColor3 = Color3.new(1, 1, 1)
				knob.Size = UDim2.new(0, 18, 0, 18)
				knob.AnchorPoint = Vector2.new(0, 0.5)
				knob.Position = UDim2.new(0, 3, 0.5, 0)
				knob.ZIndex = 9
				knob.Parent = pill
				round(knob, UDim.new(1, 0))
			end

			local state = default
			local function applyState(fire)
				if isCheck then
					tween(pill, EASE_SOFT, { BackgroundColor3 = state and accent or COLOR_OFF })
					tween(checkMark, EASE_FAST, { TextTransparency = state and 0 or 1 })
				elseif state then
					tween(pill, EASE_SOFT, { BackgroundColor3 = accent })
					tween(knob, EASE_BOUNCE, { Position = UDim2.new(1, -21, 0.5, 0) })
				else
					tween(pill, EASE_SOFT, { BackgroundColor3 = COLOR_OFF })
					tween(knob, EASE_BOUNCE, { Position = UDim2.new(0, 3, 0.5, 0) })
				end
				if fire and callback then
					local ok, err = pcall(callback, state)
					if not ok then warn("[ProUI Toggle Error]", err) end
				end
			end
			applyState(false)
			local function flip() state = not state; applyState(true) end
			pill.MouseButton1Click:Connect(flip)
			pill.TouchTap:Connect(flip)
			applyPressEffect(pill, 0.9)

			local obj = {
				Set = function(_, v) state = v and true or false; applyState(true) end,
				Get = function() return state end,
			}
			return attachCommon(obj, row, flag)
		end

