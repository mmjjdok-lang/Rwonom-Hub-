local function playIntroSplash(cfg, onDone)
	cfg = cfg or {}
	if cfg.Enabled == false then onDone() return end

	local text = cfg.Text or "Rwonom hub"
	local color = resolveColor(cfg.Color, COLOR_RED)
	-- ملاحظة: "arced" ليس اسم خط رسمي داخل Roblox، استخدمت أقرب خط جاهز
	-- بنفس الطابع الحاد/المخيف (Creepster) — تقدر تغيّره من cfg.Font
	local font = cfg.Font or Enum.Font.Creepster

	local logo = Instance.new("Frame")
	logo.AnchorPoint = Vector2.new(0.5, 0.5)
	logo.Position = UDim2.new(0.5, 0, 0.5, 0)
	logo.Size = UDim2.new(0, 0, 0, 0)
	logo.BackgroundColor3 = Color3.fromRGB(8, 8, 10)
	logo.BackgroundTransparency = 1
	logo.Rotation = -180
	logo.ZIndex = 200
	logo.Parent = screenGui
	round(logo, UDim.new(0, 16))

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Text = text
	label.Font = font
	label.TextSize = 28
	label.TextColor3 = color
	label.TextTransparency = 1
	label.Size = UDim2.new(1, -10, 1, -10)
	label.Position = UDim2.new(0, 5, 0, 5)
	label.TextScaled = true
	label.ZIndex = 201
	label.Parent = logo

	task.spawn(function()
		-- 1) الظهور: تكبير + دوران + تلاشي دخول
		tween(logo, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 170, 0, 170), Rotation = 0, BackgroundTransparency = 0,
		})
		tween(label, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextTransparency = 0 })
		task.wait(0.6)

		-- 2) نبض الاسم (تكبير/تصغير سريع متكرر) لمدة ~2.4 ثانية
		for _ = 1, 4 do
			tween(logo, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Size = UDim2.new(0, 184, 0, 184) })
			task.wait(0.3)
			tween(logo, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.In), { Size = UDim2.new(0, 170, 0, 170) })
			task.wait(0.3)
		end

		-- 3) الاختفاء: دوران عكسي + تصغير حتى 0×0 + تلاشي
		tween(logo, TweenInfo.new(1, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0), Rotation = 180, BackgroundTransparency = 1,
		})
		tween(label, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 })
		task.wait(1)

		logo:Destroy()
		onDone()
	end)
end

