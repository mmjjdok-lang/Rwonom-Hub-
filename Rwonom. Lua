		----------------------------------------------------------
		-- Dropdown: عادي أو متعدد الاختيار (Multi = true)
		--   CreateDropdown(name, options, callback)
		--   CreateDropdown(name, options, callback, true, {"A","B"})
		--   CreateDropdown({Name=, Options=, Multi=true, Default=, Callback=, Flag=})
		----------------------------------------------------------
		function Tab:CreateDropdown(name, options, callback, multi, default)
			local flag
			if type(name) == "table" then
				local o = name
				name, options, callback = pick(o, "Name", "Title", "Text"), pick(o, "Options", "Values", "List"), pick(o, "Callback", "Function", "Func")
				multi, default, flag = pick(o, "Multi", "Multiple"), pick(o, "Default", "Value"), pick(o, "Flag")
			end
			name = tostring(name or "Dropdown")
			options = options or {}
			multi = multi == true

			local selectedSingle = nil
			local selectedMulti = {}
			if multi then
				if type(default) == "table" then
					for _, v in ipairs(default) do selectedMulti[v] = true end
				elseif default ~= nil then
					selectedMulti[default] = true
				end
			else
				selectedSingle = default ~= nil and default or options[1]
			end

			local wrap = Instance.new("Frame")
			wrap.BackgroundTransparency = 1
			wrap.Size = UDim2.new(1, 0, 0, 40)
			wrap.ClipsDescendants = true
			wrap.ZIndex = 7
			wrap.Parent = page

			local header = Instance.new("TextButton")
			header.Text = ""
			header.AutoButtonColor = false
			header.BackgroundColor3 = Color3.new(1, 1, 1)
			header.BackgroundTransparency = 0.93
			header.Size = UDim2.new(1, 0, 0, 40)
			header.ZIndex = 7
			header.Parent = wrap
			round(header, UDim.new(0, 10))

			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Text = name
			label.Font = Enum.Font.Gotham
			label.TextSize = 14
			label.TextColor3 = Color3.new(1, 1, 1)
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Position = UDim2.new(0, 12, 0, 0)
			label.Size = UDim2.new(0.5, 0, 1, 0)
			label.ZIndex = 8
			label.Parent = header

			local valueLabel = Instance.new("TextLabel")
			valueLabel.BackgroundTransparency = 1
			valueLabel.Font = Enum.Font.GothamMedium
			valueLabel.TextSize = 13
			valueLabel.TextColor3 = accent
			valueLabel.TextXAlignment = Enum.TextXAlignment.Right
			valueLabel.TextTruncate = Enum.TextTruncate.AtEnd
			valueLabel.Position = UDim2.new(0.4, 0, 0, 0)
			valueLabel.Size = UDim2.new(0.6, -12, 1, 0)
			valueLabel.ZIndex = 8
			valueLabel.Parent = header

			local list = Instance.new("ScrollingFrame")
			list.BackgroundTransparency = 1
			list.BorderSizePixel = 0
			list.ScrollBarThickness = 2
			list.CanvasSize = UDim2.new(0, 0, 0, 0)
			list.Position = UDim2.new(0, 0, 0, 44)
			list.Size = UDim2.new(1, 0, 0, 0)
			list.ZIndex = 7
			list.Parent = wrap
			local listLayout = Instance.new("UIListLayout")
			listLayout.Padding = UDim.new(0, 4)
			listLayout.SortOrder = Enum.SortOrder.LayoutOrder
			listLayout.Parent = list

			local optionButtons = {}

			local function getMultiList()
				local result = {}
				for _, opt in ipairs(options) do
					if selectedMulti[opt] then table.insert(result, opt) end
				end
				return result
			end

			local function refreshVisual()
				local text
				if multi then
					local names = getMultiList()
					if #names == 0 then
						text = "—"
					else
						text = table.concat(names, ", ")
						if #text > 20 then text = tostring(#names) .. " ✓" end
					end
				else
					text = selectedSingle ~= nil and tostring(selectedSingle) or "—"
				end
				valueLabel.Text = text .. "  ▾"
				for _, entry in ipairs(optionButtons) do
					local on
					if multi then on = selectedMulti[entry.opt] == true else on = selectedSingle == entry.opt end
					entry.btn.BackgroundColor3 = on and accent or Color3.new(1, 1, 1)
					entry.btn.BackgroundTransparency = on and 0.7 or 0.92
					entry.btn.Text = ((multi and on) and "✓  " or "") .. tostring(entry.opt)
				end
			end

			local expanded = false
			local function listHeight() return math.min(#options * 32, 160) end
			local function applyExpansion(animated)
				local h = expanded and listHeight() or 0
				local info = animated and EASE_SOFT or TweenInfo.new(0)
				tween(wrap, info, { Size = UDim2.new(1, 0, 0, 40 + (expanded and (4 + h) or 0)) })
				tween(list, info, { Size = UDim2.new(1, 0, 0, h) })
			end

			local function fireCallback()
				if not callback then return end
				local arg = multi and getMultiList() or selectedSingle
				local ok, err = pcall(callback, arg)
				if not ok then warn("[ProUI Dropdown Error]", err) end
			end

			local function buildOptions()
				for _, c in ipairs(list:GetChildren()) do
					if c:IsA("TextButton") then c:Destroy() end
				end
				optionButtons = {}
				for i, opt in ipairs(options) do
					local optBtn = Instance.new("TextButton")
					optBtn.Text = tostring(opt)
					optBtn.Font = Enum.Font.Gotham
					optBtn.TextSize = 13
					optBtn.TextColor3 = Color3.new(1, 1, 1)
					optBtn.AutoButtonColor = false
					optBtn.BackgroundColor3 = Color3.new(1, 1, 1)
					optBtn.BackgroundTransparency = 0.92
					optBtn.Size = UDim2.new(1, 0, 0, 28)
					optBtn.LayoutOrder = i
					optBtn.ZIndex = 8
					optBtn.Parent = list
					round(optBtn, UDim.new(0, 8))
					applyPressEffect(optBtn, 0.96)
					table.insert(optionButtons, { btn = optBtn, opt = opt })

					local function choose()
						if multi then
							selectedMulti[opt] = not selectedMulti[opt] or nil
							refreshVisual()
							fireCallback()
						else
							selectedSingle = opt
							refreshVisual()
							expanded = false
							applyExpansion(true)
							fireCallback()
						end
					end
					optBtn.MouseButton1Click:Connect(choose)
					optBtn.TouchTap:Connect(choose)
				end
				list.CanvasSize = UDim2.new(0, 0, 0, #options * 32)
				refreshVisual()
			end
			buildOptions()

			local function toggleList()
				expanded = not expanded
				applyExpansion(true)
			end
			header.MouseButton1Click:Connect(toggleList)
			header.TouchTap:Connect(toggleList)
			applyPressEffect(header, 0.97)

			local obj = {
				Get = function()
					if multi then return getMultiList() end
					return selectedSingle
				end,
				Set = function(_, v, silent)
					if multi then
						selectedMulti = {}
						if type(v) == "table" then
							for _, x in ipairs(v) do selectedMulti[x] = true end
						elseif v ~= nil then
							selectedMulti[v] = true
						end
					else
						selectedSingle = v
					end
					refreshVisual()
					if not silent then fireCallback() end
				end,
				Refresh = function(_, newOptions)
					options = newOptions or {}
					if multi then
						for k in pairs(selectedMulti) do
							if not table.find(options, k) then selectedMulti[k] = nil end
						end
					elseif selectedSingle == nil or not table.find(options, selectedSingle) then
						selectedSingle = options[1]
					end
					buildOptions()
					applyExpansion(false)
				end,
			}
			return attachCommon(obj, wrap, flag)
		end

		function Tab:CreateMultiDropdown(name, options, callback, default)
			if type(name) == "table" then
				local o = name
				local copy = {}
				for k, v in pairs(o) do copy[k] = v end
				copy.Multi = true
				return Tab:CreateDropdown(copy)
			end
			return Tab:CreateDropdown(name, options, callback, true, default)
		end

