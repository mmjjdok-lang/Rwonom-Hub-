-- نظام تدرج عام قابل للتطبيق على أي عنصر (فريم/زر/حافة UIStroke)
-- Library.ApplyGradient(target, {
--     Colors    = {Color3 أو اسم لون, ...}  -- لونين أو أكثر
--     Speed     = 6     -- ثواني لدورة دوران كاملة (أقل = أسرع)
--     Intensity = 1      -- قوة/وضوح التدرج من 0 إلى 1
--     Rotation  = 0      -- زاوية البداية
-- })
-- لو استدعيتها مرة ثانية على نفس العنصر، تضيف طبقة تدرج ثانية فوقه
-- (بدل ما تستبدل الأولى) — لأن روبلوكس ما يدعم تدرجين فعّالين مباشرة
-- على نفس العنصر، فنستخدم فريم شفاف إضافي فوقه يحمل الطبقة الثانية.
function Library.ApplyGradient(target, config)
	config = config or {}
	local rawColors = config.Colors or { COLOR_GREEN, COLOR_PURPLE }
	local colors = {}
	for i, c in ipairs(rawColors) do colors[i] = resolveColor(c, COLOR_GREEN) end
	if #colors < 2 then colors[2] = COLOR_PURPLE end

	local speed = math.max(tonumber(config.Speed) or 6, 0.3)
	local intensity = math.clamp(config.Intensity or 1, 0, 1)
	local rotation = config.Rotation or 0

	local layerCount = (target:GetAttribute("ProUI_Gradients")) or 0
	local host = target
	if layerCount > 0 then
		host = Instance.new("Frame")
		host.Name = "GradientLayer" .. (layerCount + 1)
		host.BackgroundColor3 = Color3.new(1, 1, 1)
		host.BackgroundTransparency = 1
		host.BorderSizePixel = 0
		host.Size = UDim2.new(1, 0, 1, 0)
		host.ZIndex = (target:IsA("GuiObject") and target.ZIndex or 1) + layerCount
		host.Parent = target
		local srcCorner = target:FindFirstChildOfClass("UICorner")
		if srcCorner then round(host, srcCorner.CornerRadius) end
	end

	local kps = {}
	for i, c in ipairs(colors) do
		kps[i] = ColorSequenceKeypoint.new(#colors > 1 and (i - 1) / (#colors - 1) or 0, c)
	end

	local grad = Instance.new("UIGradient")
	grad.Rotation = rotation
	grad.Color = ColorSequence.new(kps)
	grad.Transparency = NumberSequence.new(1 - intensity)
	grad.Parent = host

	pcall(function() target:SetAttribute("ProUI_Gradients", layerCount + 1) end)

	task.spawn(function()
		while grad.Parent do
			grad.Rotation = (grad.Rotation + 2) % 360
			task.wait(speed / 180)
		end
	end)

	return grad
end

