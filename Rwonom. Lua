			label.Size = UDim2.new(0.5, 0, 1, 0)
			label.ZIndex = 8
			label.Parent = header

			local valueLabel = Instance.new("TextLabel")
			valueLabel.BackgroundTransparency = 1
			valueLabel.Text = (options[1] or "—") .. "  ▾"
			valueLabel.Font = Enum.Font.GothamMedium
			valueLabel.TextSize = 13
			valueLabel.TextColor3 = accent
			valueLabel.TextXAlignment = Enum.TextXAlignment.Right
			valueLabel.Position = UDim2.new(0.45, 0, 0, 0)
			valueLabel.Size = UDim2.new(0.55, -12, 1, 0)
			valueLabel.ZIndex = 8
			valueLabel.Parent = header

			local list = Instance.new("Frame")
			list.BackgroundTransparency = 1
			list.Position = UDim2.new(0, 0, 0, 44)
			list.Size = UDim2.new(1, 0, 0, 0)
			list.ZIndex = 7
			list.Parent = wrap
			local listLayout = Instance.new("UIListLayout")
			listLayout.Padding = UDim.new(0, 4)
			listLayout.SortOrder = Enum.SortOrder.LayoutOrder
			listLayout.Parent = list

			local expanded = false
			local function toggleList()
				expanded = not expanded
				local targetH = expanded and (#options * 32) or 0
				tween(wrap, EASE_SOFT, { Size = UDim2.new(1, 0, 0, 40 + (expanded and (4 + targetH) or 0)) })
				tween(list, EASE_SOFT, { Size = UDim2.new(1, 0, 0, targetH) })
			end
			header.MouseButton1Click:Connect(toggleList)
			header.TouchTap:Connect(toggleList)
			applyPressEffect(header, 0.97)

			for i, opt in ipairs(options) do
				local optBtn = Instance.new("TextButton")
				optBtn.Text = opt
				optBtn.Font = Enum.Font.Gotham
				optBtn.TextSize = 13
				optBtn.TextColor3 = Color3.new(1, 1, 1)
				optBtn.AutoButtonColor = false
				optBtn.BackgroundColor3 = Color3.new(1, 1, 1)
				optBtn.BackgroundTransparency = 0.92
				optBtn.Size = UDim2.new(1, 0, 0, 28)
				optBtn.LayoutOrder = i
				optBtn.ZIndex = 8
				optBtn.Parent = list
				round(optBtn, UDim.new(0, 8))
				applyPressEffect(optBtn, 0.96)

				local function choose()
					valueLabel.Text = opt .. "  ▾"
					toggleList()
					if callback then
						local ok, err = pcall(callback, opt)
						if not ok then warn("[ProUI Dropdown Error]", err) end
					end
				end
				optBtn.MouseButton1Click:Connect(choose)
				optBtn.TouchTap:Connect(choose)
			end

			return { Get = function() return valueLabel.Text:gsub("  ▾", "") end }
		end

		----------------------------------------------------------
		-- منتقي ألوان بأسلوب WindUI (مربع تشبع/قيمة + شريط تدرج + هيكس + تأكيد/إلغاء)
		function Tab:CreateColorPicker(name, defaultColor, callback)
			defaultColor = defaultColor or COLOR_GREEN
			local row = Instance.new("Frame")
			row.BackgroundColor3 = Color3.new(1, 1, 1)
			row.BackgroundTransparency = 0.93
			row.Size = UDim2.new(1, 0, 0, 40)
			row.ZIndex = 7
			row.Parent = page
			round(row, UDim.new(0, 10))

			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Text = name
			label.Font = Enum.Font.Gotham
			label.TextSize = 14
			label.TextColor3 = Color3.new(1, 1, 1)
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Position = UDim2.new(0, 12, 0, 0)
			label.Size = UDim2.new(1, -60, 1, 0)
			label.ZIndex = 8
			label.Parent = row

			local swatch = Instance.new("TextButton")
			swatch.Text = ""
			swatch.AutoButtonColor = false
			swatch.BackgroundColor3 = defaultColor
			swatch.Size = UDim2.new(0, 34, 0, 22)
			swatch.AnchorPoint = Vector2.new(1, 0.5)
			swatch.Position = UDim2.new(1, -12, 0.5, 0)
			swatch.ZIndex = 8
			swatch.Parent = row
			round(swatch, UDim.new(0, 6))
			stroke(swatch, Color3.new(1, 1, 1), 1, 0.5)
			applyPressEffect(swatch, 0.9)

			-- نافذة الاختيار المنبثقة (فوق الواجهة كلها)
			local popup = Instance.new("Frame")
			popup.BackgroundColor3 = COLOR_DARK
			popup.AnchorPoint = Vector2.new(0.5, 0.5)
			popup.Position = UDim2.new(0.5, 0, 0.5, 0)
			popup.Size = UDim2.new(0, 250, 0, 230)
			popup.Visible = false
			popup.ZIndex = 60
			popup.Parent = mainFrame
			round(popup, UDim.new(0, 14))
			stroke(popup, COLOR_PURPLE, 1, 0.3)

			local h, s, v = Color3.toHSV(defaultColor)

			local svBox = Instance.new("Frame")
			svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			svBox.Position = UDim2.new(0, 14, 0, 14)
			svBox.Size = UDim2.new(0, 170, 0, 150)
			svBox.ZIndex = 61
			svBox.Parent = popup
			round(svBox, UDim.new(0, 8))

			local satOverlay = Instance.new("Frame")
			satOverlay.BackgroundColor3 = Color3.new(1, 1, 1)
			satOverlay.BorderSizePixel = 0
			satOverlay.Size = UDim2.new(1, 0, 1, 0)
			satOverlay.ZIndex = 62
			satOverlay.Parent = svBox
			local satGrad = Instance.new("UIGradient")
			satGrad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
			satGrad.Parent = satOverlay

			local valOverlay = Instance.new("Frame")
			valOverlay.BackgroundColor3 = Color3.new(0, 0, 0)
			valOverlay.BorderSizePixel = 0
			valOverlay.Size = UDim2.new(1, 0, 1, 0)
			valOverlay.ZIndex = 63
			valOverlay.Parent = svBox
			local valGrad = Instance.new("UIGradient")
			valGrad.Rotation = 90
			valGrad.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
			valGrad.Parent = valOverlay

			local svKnob = Instance.new("Frame")
			svKnob.BackgroundColor3 = Color3.new(1, 1, 1)
			svKnob.Size = UDim2.new(0, 12, 0, 12)
			svKnob.AnchorPoint = Vector2.new(0.5, 0.5)
			svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
			svKnob.ZIndex = 64
			svKnob.Parent = svBox
			round(svKnob, UDim.new(1, 0))
			stroke(svKnob, Color3.new(0, 0, 0), 1.5, 0)

			local hueStrip = Instance.new("Frame")
			hueStrip.Position = UDim2.new(0, 194, 0, 14)
			hueStrip.Size = UDim2.new(0, 20, 0, 150)
			hueStrip.ZIndex = 61
			hueStrip.Parent = popup
			round(hueStrip, UDim.new(0, 8))
			local hueGrad = Instance.new("UIGradient")
			hueGrad.Rotation = 90
			hueGrad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)), ColorSequenceKeypoint.new(1/6, Color3.fromHSV(1/6, 1, 1)),
				ColorSequenceKeypoint.new(2/6, Color3.fromHSV(2/6, 1, 1)), ColorSequenceKeypoint.new(3/6, Color3.fromHSV(3/6, 1, 1)),
				ColorSequenceKeypoint.new(4/6, Color3.fromHSV(4/6, 1, 1)), ColorSequenceKeypoint.new(5/6, Color3.fromHSV(5/6, 1, 1)),
				ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
			})
			hueGrad.Parent = hueStrip

			local hueKnob = Instance.new("Frame")
			hueKnob.BackgroundColor3 = Color3.new(1, 1, 1)
			hueKnob.Size = UDim2.new(1, 4, 0, 4)
			hueKnob.AnchorPoint = Vector2.new(0.5, 0.5)
			hueKnob.Position = UDim2.new(0.5, 0, h, 0)
			hueKnob.ZIndex = 62
			hueKnob.Parent = hueStrip
			round(hueKnob, UDim.new(0, 2))

			local hexBox = Instance.new("TextBox")
			hexBox.Text = color3ToHex(defaultColor)
			hexBox.Font = Enum.Font.Code
			hexBox.TextSize = 13
			hexBox.TextColor3 = Color3.new(1, 1, 1)
			hexBox.BackgroundColor3 = Color3.new(1, 1, 1)
			hexBox.BackgroundTransparency = 0.9
			hexBox.ClearTextOnFocus = false
			hexBox.Position = UDim2.new(0, 14, 0, 172)
			hexBox.Size = UDim2.new(0, 100, 0, 24)
			hexBox.ZIndex = 61
			hexBox.Parent = popup
			round(hexBox, UDim.new(0, 6))

			local nameLbl = Instance.new("TextLabel")
			nameLbl.BackgroundTransparency = 1
			nameLbl.Text = T("nearest_color") .. ": " .. nearestColorName(defaultColor)
			nameLbl.Font = Enum.Font.Gotham
			nameLbl.TextSize = 11
			nameLbl.TextColor3 = Color3.fromRGB(200, 200, 210)
			nameLbl.TextXAlignment = Enum.TextXAlignment.Left
			nameLbl.Position = UDim2.new(0, 120, 0, 172)
			nameLbl.Size = UDim2.new(0, 116, 0, 24)
			nameLbl.ZIndex = 61
			nameLbl.Parent = popup

			local startBtn = Instance.new("TextButton")
			startBtn.Text = T("pick_start")
			startBtn.Font = Enum.Font.GothamBold
			startBtn.TextSize = 13
			startBtn.TextColor3 = Color3.new(1, 1, 1)
			startBtn.AutoButtonColor = false
			startBtn.BackgroundColor3 = COLOR_GREEN
			startBtn.Position = UDim2.new(0, 14, 1, -42)
			startBtn.Size = UDim2.new(0, 100, 0, 28)
			startBtn.ZIndex = 61
			startBtn.Parent = popup
			round(startBtn, UDim.new(0, 8))
			applyPressEffect(startBtn, 0.9)

			local cancelBtn = Instance.new("TextButton")
			cancelBtn.Text = T("pick_cancel")
			cancelBtn.Font = Enum.Font.GothamBold
			cancelBtn.TextSize = 13
			cancelBtn.TextColor3 = Color3.new(1, 1, 1)
			cancelBtn.AutoButtonColor = false
			cancelBtn.BackgroundColor3 = COLOR_OFF
			cancelBtn.Position = UDim2.new(1, -114, 1, -42)
			cancelBtn.Size = UDim2.new(0, 100, 0, 28)
			cancelBtn.ZIndex = 61
			cancelBtn.Parent = popup
			round(cancelBtn, UDim.new(0, 8))
			applyPressEffect(cancelBtn, 0.9)

			local function currentColor() return Color3.fromHSV(h, s, v) end
			local function refreshUI()
				svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
				hexBox.Text = color3ToHex(currentColor())
				nameLbl.Text = T("nearest_color") .. ": " .. nearestColorName(currentColor())
			end

			makeSingleTouchDraggable(svBox, function(inputPos)
				local pos, size = svBox.AbsolutePosition, svBox.AbsoluteSize
				s = math.clamp((inputPos.X - pos.X) / size.X, 0, 1)
				v = math.clamp(1 - (inputPos.Y - pos.Y) / size.Y, 0, 1)
				svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
				refreshUI()
			end)
			makeSingleTouchDraggable(hueStrip, function(inputPos)
				local pos, size = hueStrip.AbsolutePosition, hueStrip.AbsoluteSize
				h = math.clamp((inputPos.Y - pos.Y) / size.Y, 0, 1)
				hueKnob.Position = UDim2.new(0.5, 0, h, 0)
				refreshUI()
			end)

			hexBox.FocusLost:Connect(function()
				local c = hexToColor3(hexBox.Text)
				if c then
					h, s, v = Color3.toHSV(c)
					svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
					hueKnob.Position = UDim2.new(0.5, 0, h, 0)
					refreshUI()
				end
			end)

			local function openPicker()
				popup.Visible = true
				popup.Size = UDim2.new(0, 0, 0, 0)
				tween(popup, EASE_BOUNCE, { Size = UDim2.new(0, 250, 0, 230) })
			end
			local function closePicker()
				local t = tween(popup, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(0, 0, 0, 0) })
				t.Completed:Connect(function() popup.Visible = false end)
			end

			swatch.MouseButton1Click:Connect(openPicker)
			swatch.TouchTap:Connect(openPicker)
			cancelBtn.MouseButton1Click:Connect(closePicker)
			cancelBtn.TouchTap:Connect(closePicker)

			local function confirmPick()
				local c = currentColor()
				swatch.BackgroundColor3 = c
				closePicker()
				if callback then
					local ok, err = pcall(callback, c)
					if not ok then warn("[ProUI ColorPicker Error]", err) end
				end
			end
			startBtn.MouseButton1Click:Connect(confirmPick)
			startBtn.TouchTap:Connect(confirmPick)

			return { Get = function() return swatch.BackgroundColor3 end }
		end

		Window.Tabs[name] = Tab
		return Tab
	end

	Window.Open, Window.Close = openUI, performClose

	----------------------------------------------------------
	-- تشغيل السبلاش الترحيبي ثم فتح الواجهة تلقائياً
	----------------------------------------------------------
	openButton.Visible = false
	playIntroSplash(config.Splash, function() openUI() end)

	return Window
end

return Library

