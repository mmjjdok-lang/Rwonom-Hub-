-- اسم اللون -> Color3 (عشان تقدر تكتب اسم اللون بدل ما تكتب RGB)
local NAMED_COLORS = {
	blue = COLOR_BLUE, green = COLOR_GREEN, purple = COLOR_PURPLE, red = COLOR_RED,
	orange = COLOR_ORANGE, pink = COLOR_PINK, yellow = COLOR_YELLOW, cyan = COLOR_CYAN,
	dark = COLOR_DARK, white = Color3.fromRGB(255, 255, 255), black = Color3.fromRGB(10, 10, 14),
}

local function resolveColor(value, fallback)
	if typeof(value) == "Color3" then return value end
	if type(value) == "string" then
		local c = NAMED_COLORS[value:lower()]
		if c then return c end
	end
	return fallback
end

