				svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
				hexBox.Text = color3ToHex(currentColor())
				nameLbl.Text = T("nearest_color") .. ": " .. nearestColorName(currentColor())
			end

			makeSingleTouchDraggable(svBox, function(inputPos)
				local pos, size = svBox.AbsolutePosition, svBox.AbsoluteSize
				s = math.clamp((inputPos.X - pos.X) / size.X, 0, 1)
				v = math.clamp(1 - (inputPos.Y - pos.Y) / size.Y, 0, 1)
				svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
				refreshUI()
			end)
			makeSingleTouchDraggable(hueStrip, function(inputPos)
				local pos, size = hueStrip.AbsolutePosition, hueStrip.AbsoluteSize
				h = math.clamp((inputPos.Y - pos.Y) / size.Y, 0, 1)
				hueKnob.Position = UDim2.new(0.5, 0, h, 0)
				refreshUI()
			end)

			hexBox.FocusLost:Connect(function()
				local c = hexToColor3(hexBox.Text)
				if c then
					h, s, v = Color3.toHSV(c)
					svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
					hueKnob.Position = UDim2.new(0.5, 0, h, 0)
					refreshUI()
				end
			end)

			local function openPicker()
				openPopupCount = openPopupCount + 1
				popup.Position = UDim2.new(0.5, 0, 0.5, 0)
				popup.Visible = true
				popup.Size = UDim2.new(0, 0, 0, 0)
				tween(popup, EASE_BOUNCE, { Size = UDim2.new(0, POPUP_W, 0, POPUP_H) })
			end
			local function closePicker()
				openPopupCount = math.max(openPopupCount - 1, 0)
				local t = tween(popup, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(0, 0, 0, 0) })
				t.Completed:Connect(function() popup.Visible = false end)
			end

			swatch.MouseButton1Click:Connect(openPicker)
			swatch.TouchTap:Connect(openPicker)
			cancelBtn.MouseButton1Click:Connect(closePicker)
			cancelBtn.TouchTap:Connect(closePicker)

			local function confirmPick()
				local c = currentColor()
				swatch.BackgroundColor3 = c
				closePicker()
				if callback then
					local ok, err = pcall(callback, c)
					if not ok then warn("[ProUI ColorPicker Error]", err) end
				end
			end
			startBtn.MouseButton1Click:Connect(confirmPick)
			startBtn.TouchTap:Connect(confirmPick)

			return { Get = function() return swatch.BackgroundColor3 end }
		end

		-- أسماء بديلة (بأسلوب WindUI / Rayfield)
		Tab.Button, Tab.Toggle, Tab.Slider = Tab.CreateButton, Tab.CreateToggle, Tab.CreateSlider
		Tab.Input, Tab.Textbox, Tab.Dropdown = Tab.CreateTextbox, Tab.CreateTextbox, Tab.CreateDropdown
		Tab.Colorpicker, Tab.ColorPicker = Tab.CreateColorPicker, Tab.CreateColorPicker
		Tab.Label, Tab.Note = Tab.CreateLabel, Tab.CreateNote

		Window.Tabs[name] = Tab
		return Tab
	end
	Window.Tab = Window.CreateTab

	-- إنشاء عنصر داخل تبويب عن طريق اسم التبويب (أو كائن التبويب):
	--   Window:CreateButton("اسم التبويب", "اسم الزر", "وصف", function() end)
	--   Window:CreateButton({Tab = "اسم التبويب", Name = "...", Callback = function() end})
	for _, kind in ipairs({ "Button", "Toggle", "Slider", "Textbox", "Dropdown", "ColorPicker", "Label", "Note" }) do
		Window["Create" .. kind] = function(self, tab, ...)
			local args = { ... }
			if type(tab) == "table" and not tab.Page then
				local o = tab
				tab = pick(o, "Tab", "TabName")
				args = { o }
			end
			local target = (type(tab) == "table" and tab.Page) and tab or Window.Tabs[tostring(tab)]
			if not target then
				warn("[ProUI] التبويب غير موجود:", tostring(tab), "- أنشئه أولاً بـ Window:CreateTab")
				return nil
			end
			return target["Create" .. kind](target, table.unpack(args))
		end
	end

	Window.Open, Window.Close, Window.Minimize, Window.Delete = openUI, hideUI, toggleMinimize, deleteEverything

	-- مراجع جاهزة لاستخدامها مع Library.ApplyGradient(Window.XXX, {...})
	Window.OpenButton  = openButton         -- تدرج على زر Open
	Window.Frame       = mainFrame          -- تدرج على جسم الواجهة
	Window.FrameStroke = mainStroke         -- تدرج على حواف الواجهة

	----------------------------------------------------------
	-- تشغيل السبلاش الترحيبي ثم فتح الواجهة تلقائياً
	----------------------------------------------------------
	openButton.Visible = false
	Library.PlaySplash(config.Splash, function() openUI() end)

	return Window
end

-- نسخة احتياطية عالمية: لو حطيت كود إنشاء نافذتك تحت سطر return بنفس
-- الملف (بدل تنفيذ/سكربت منفصل)، هذا السطر ما يشتغل بعد return أبداً —
-- بس تقدر توصل للمكتبة من أي تنفيذ (Execute) ثاني عن طريق:
--     local Library = getgenv().ProUILibrary
pcall(function()
	if getgenv then
		getgenv().ProUILibrary = Library
	end
end)

-- ⚠️ توقف هنا! أي كود تكتبه تحت سطر "return Library" التالي بنفس
-- الملف لن يعمل أبداً (return ينهي تنفيذ السكربت فوراً بهذه النقطة).
-- اكتب كود CreateWindow / CreateTab / CreateButton في تنفيذ (Execute)
-- ثاني منفصل بعد تشغيل هذا السكربت، أو استخدم getgenv() بالأعلى.
return Library

