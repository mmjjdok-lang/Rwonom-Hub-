			round(row, UDim.new(0, 10))

			local label = Instance.new("TextLabel")
			label.BackgroundTransparency = 1
			label.Text = name
			label.Font = Enum.Font.Gotham
			label.TextSize = 14
			label.TextColor3 = Color3.new(1, 1, 1)
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.Position = UDim2.new(0, 12, 0, 6)
			label.Size = UDim2.new(1, -70, 0, 18)
			label.ZIndex = 8
			label.Parent = row

			local valueLabel = Instance.new("TextLabel")
			valueLabel.BackgroundTransparency = 1
			valueLabel.Text = tostring(default)
			valueLabel.Font = Enum.Font.GothamBold
			valueLabel.TextSize = 13
			valueLabel.TextColor3 = accent
			valueLabel.TextXAlignment = Enum.TextXAlignment.Right
			valueLabel.Position = UDim2.new(1, -60, 0, 6)
			valueLabel.Size = UDim2.new(0, 48, 0, 18)
			valueLabel.ZIndex = 8
			valueLabel.Parent = row

			local track = Instance.new("Frame")
			track.BackgroundColor3 = Color3.new(1, 1, 1)
			track.BackgroundTransparency = 0.85
			track.Position = UDim2.new(0, 12, 0, 32)
			track.Size = UDim2.new(1, -24, 0, 8)
			track.ZIndex = 8
			track.Parent = row
			round(track, UDim.new(1, 0))

			local fill = Instance.new("Frame")
			fill.BackgroundColor3 = COLOR_GREEN
			fill.BorderSizePixel = 0
			fill.Size = UDim2.new(0, 0, 1, 0)
			fill.ZIndex = 9
			fill.Parent = track
			round(fill, UDim.new(1, 0))
			local fillGrad = Instance.new("UIGradient")
			fillGrad.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, COLOR_GREEN), ColorSequenceKeypoint.new(1, COLOR_PURPLE) })
			fillGrad.Parent = fill

			-- الدائرة (Knob) القابلة للسحب باللمس أو الماوس
			local knob = Instance.new("Frame")
			knob.BackgroundColor3 = Color3.new(1, 1, 1)
			knob.Size = UDim2.new(0, 16, 0, 16)
			knob.AnchorPoint = Vector2.new(0.5, 0.5)
			knob.Position = UDim2.new(0, 0, 0.5, 0)
			knob.ZIndex = 10
			knob.Parent = track
			round(knob, UDim.new(1, 0))
			stroke(knob, COLOR_PURPLE, 1.5, 0)

			local value = default
			local function updateVisual(v, animated)
				local rel = (v - min) / math.max(max - min, 1e-6)
				local info = animated and EASE_FAST or TweenInfo.new(0)
				tween(fill, info, { Size = UDim2.new(rel, 0, 1, 0) })
				tween(knob, info, { Position = UDim2.new(rel, 0, 0.5, 0) })
				valueLabel.Text = tostring(math.floor(v + 0.5))
			end
			updateVisual(default, false)

			makeSingleTouchDraggable(track, function(inputPos)
				local trackPos, trackWidth = track.AbsolutePosition.X, math.max(track.AbsoluteSize.X, 1)
				local rel = math.clamp((inputPos.X - trackPos) / trackWidth, 0, 1)
				local raw = min + (max - min) * rel
				value = math.clamp(math.floor(raw / speed + 0.5) * speed, min, max)
				updateVisual(value, true)
				if callback then
					local ok, err = pcall(callback, value)
					if not ok then warn("[ProUI Slider Error]", err) end
				end
			end)

			return { Set = function(_, v) value = math.clamp(v, min, max); updateVisual(value, true) end, Get = function() return value end }
		end

