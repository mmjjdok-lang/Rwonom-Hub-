	local activeDragInput, dragStartInputPos, dragStartAbsPos = nil, nil, nil
	topBar.InputBegan:Connect(function(input)
		local isPointer = input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
		if not isPointer or activeDragInput ~= nil then return end
		activeDragInput, dragStartInputPos, dragStartAbsPos = input, input.Position, mainFrame.AbsolutePosition
		tween(mainFrame, EASE_FAST, { Size = UDim2.new(0, sizeX - 8, 0, sizeY - 6) })
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End and activeDragInput == input then
				activeDragInput, dragStartInputPos, dragStartAbsPos = nil, nil, nil
				tween(mainFrame, EASE_BOUNCE, { Size = UDim2.new(0, sizeX, 0, sizeY) })
			end
		end)
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not activeDragInput or input ~= activeDragInput then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = input.Position - dragStartInputPos
		local cx, cy = clampFrameToScreen(mainFrame, dragStartAbsPos.X + delta.X, dragStartAbsPos.Y + delta.Y)
		local fs = mainFrame.AbsoluteSize
		tween(mainFrame, TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
			Position = UDim2.new(0, cx + fs.X / 2, 0, cy + fs.Y / 2)
		})
	end)
	UserInputService.InputEnded:Connect(function(input)
		if activeDragInput == input then
			activeDragInput, dragStartInputPos, dragStartAbsPos = nil, nil, nil
			tween(mainFrame, EASE_BOUNCE, { Size = UDim2.new(0, sizeX, 0, sizeY) })
		end
	end)

