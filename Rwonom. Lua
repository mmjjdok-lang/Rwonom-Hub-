local function AuraForceLoad(itemsToLoad, onComplete)
    local totalItems = 0
    local completed = 0
    local loadedData = {}

    for name, _ in pairs(itemsToLoad) do
        totalItems = totalItems + 1
    end

    if totalItems == 0 then
        if onComplete then onComplete() end
        return
    end

    -- ضغط سريع جداً ومتوازي (يقوم بتحميل كل شيء في نفس اللحظة بأقصى قوة للمعالج)
    for name, loadFunc in pairs(itemsToLoad) do
        task.spawn(function()
            local success, result = pcall(loadFunc)
            if success then
                loadedData[name] = result
            else
                warn("[Aura Error] فشل في تحميل: " .. tostring(name))
            end
            completed = completed + 1
        end)
    end

    -- حلقة ضغط سريعة بدون انتظار طويل لتسريع التنفيذ لأقصى حد ممكن
    local startTime = tick()
    while completed < totalItems do
        -- حلقة دوران سريعة جداً بدون task.wait عشان يجبر النظام ينهي العمليات فوراً
        -- (هنا يصير اللاج الخفيف المتعمد لحظة التحميل فقط)
        if tick() - startTime > 5 then -- حماية لو علق شي يطلع لحاله
            break
        end
    end

    -- تنظيف الذاكرة الإجباري فور انتهاء التحميل (Gc garbage collection) لضمان ثبات الأداء
    task.defer(function()
        collectgarbage("collect")
    end)

    -- تشغيل الواجهة أو النظام بعد انتهاء الضغط مباشرة
    if onComplete then
        onComplete(loadedData)
    end
end
 
