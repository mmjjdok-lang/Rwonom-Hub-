		-- أسماء بديلة (بأسلوب WindUI / Rayfield)
		Tab.Button, Tab.Toggle, Tab.Slider = Tab.CreateButton, Tab.CreateToggle, Tab.CreateSlider
		Tab.Input, Tab.Textbox, Tab.Dropdown = Tab.CreateTextbox, Tab.CreateTextbox, Tab.CreateDropdown
		Tab.Colorpicker, Tab.ColorPicker = Tab.CreateColorPicker, Tab.CreateColorPicker
		Tab.Label, Tab.Note = Tab.CreateLabel, Tab.CreateNote
		Tab.Section, Tab.Divider, Tab.Paragraph = Tab.CreateSection, Tab.CreateDivider, Tab.CreateParagraph
		Tab.Keybind, Tab.Progress, Tab.Code = Tab.CreateKeybind, Tab.CreateProgress, Tab.CreateCode
		Tab.MultiDropdown = Tab.CreateMultiDropdown

		Window.Tabs[name] = Tab
		return Tab
	end
	Window.Tab = Window.CreateTab

	-- إنشاء عنصر داخل تبويب عن طريق اسم التبويب:
	--   Window:CreateButton("اسم التبويب", "اسم الزر", "وصف", function() end)
	for _, kind in ipairs(ELEMENT_KINDS) do
		Window["Create" .. kind] = function(self, tab, ...)
			local args = { ... }
			if type(tab) == "table" and not tab.Page then
				local o = tab
				tab = pick(o, "Tab", "TabName")
				args = { o }
			end
			local target = (type(tab) == "table" and tab.Page) and tab or Window.Tabs[tostring(tab)]
			if not target then
				warn("[ProUI] التبويب غير موجود:", tostring(tab), "- أنشئه أولاً بـ Window:CreateTab")
				return nil
			end
			return target["Create" .. kind](target, table.unpack(args))
		end
	end

	-- دوال عامة للنافذة
	function Window:Dialog(cfg) return Library.Dialog(cfg) end
	function Window:Notify(...) return Library.Notify(...) end
	function Window:SetTitle(t) titleLabel.Text = tostring(t) end
	function Window:SetSubTitle(t) if subLabel then subLabel.Text = tostring(t) end end
	function Window:SetToggleKey(k) toggleKey = toKeyCode(k) end
	function Window:SaveConfig(n) return Library.SaveConfig(n) end
	function Window:LoadConfig(n) return Library.LoadConfig(n) end
	function Window:ListConfigs() return Library.ListConfigs() end

	Window.Open, Window.Close, Window.Minimize, Window.Delete = openUI, hideUI, toggleMinimize, deleteEverything

	-- مراجع جاهزة لاستخدامها مع Library.ApplyGradient(Window.XXX, {...})
	Window.OpenButton  = openButton
	Window.Frame       = mainFrame
	Window.FrameStroke = mainStroke

	----------------------------------------------------------
	-- بدء التشغيل: النافذة مستقلة عن الـ Splash.
	--   افتراضياً تفتح مباشرة. config.AutoOpen = false => يظهر زر Open فقط.
	--   (توافق قديم: لو مررت config.Splash يشغّله ثم يفتح)
	----------------------------------------------------------
	if config.Splash then
		openButton.Visible = false
		Library.Splash(config.Splash, function() openUI() end)
	elseif config.AutoOpen == false then
		openButton.Visible = true
	else
		openButton.Visible = false
		openUI()
	end

	return Window
end

pcall(function()
	if getgenv then
		getgenv().ProUILibrary = Library
	end
end)

