local Flags = {}

local function registerFlag(flag, obj)
	if flag and obj then Flags[tostring(flag)] = obj end
end

local function encodeValue(v)
	if typeof(v) == "Color3" then return { __color = color3ToHex(v) } end
	if typeof(v) == "EnumItem" then return { __key = v.Name } end
	return v
end

local function decodeValue(v)
	if type(v) == "table" then
		if v.__color then return hexToColor3(v.__color) end
		if v.__key then
			local ok, e = pcall(function() return Enum.KeyCode[v.__key] end)
			return ok and e or nil
		end
	end
	return v
end

-- يضيف لأي عنصر: Lock / Unlock / SetVisible / Destroy / SetFlag
local function attachCommon(obj, row, flag)
	obj.Row = row
	obj.SetVisible = function(_, v) row.Visible = v and true or false end
	obj.Destroy = function() row:Destroy() end

	local overlay
	obj.Lock = function()
		if overlay then return end
		overlay = Instance.new("TextButton")
		overlay.Text = ""
		overlay.AutoButtonColor = false
		overlay.BackgroundColor3 = Color3.new(0, 0, 0)
		overlay.BackgroundTransparency = 0.55
		overlay.Size = UDim2.new(1, 0, 1, 0)
		overlay.ZIndex = 40
		overlay.Parent = row
		round(overlay, UDim.new(0, 10))
		local lockIcon = Instance.new("TextLabel")
		lockIcon.BackgroundTransparency = 1
		lockIcon.Text = "🔒"
		lockIcon.TextSize = 14
		lockIcon.Font = Enum.Font.GothamBold
		lockIcon.TextColor3 = Color3.new(1, 1, 1)
		lockIcon.AnchorPoint = Vector2.new(1, 0.5)
		lockIcon.Position = UDim2.new(1, -10, 0.5, 0)
		lockIcon.Size = UDim2.new(0, 20, 0, 20)
		lockIcon.ZIndex = 41
		lockIcon.Parent = overlay
	end
	obj.Unlock = function()
		if overlay then overlay:Destroy(); overlay = nil end
	end
	obj.SetFlag = function(self, f) registerFlag(f, self); return self end

	if flag then registerFlag(flag, obj) end
	return obj
end

