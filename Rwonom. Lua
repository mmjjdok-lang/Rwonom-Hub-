--============================================================
-- 5) نظام Splash (الشعار) — مستقل تماماً عن النافذة
--   يعمل بـ ScreenGui خاص فيه، تقدر تشغله قبل/بدون/بعد النافذة.
--
--   Library.Splash({
--       Text = "اسم الشعار",
--       Font = "Bangers",            -- اسم من Enum.Font أو Enum.Font.X
--       Color = "Cyan",              -- لون الاسم
--       BackgroundColor = "Dark",    -- لون خلفية الشعار
--       Size = 200,                  -- حجم الشعار (بكسل)
--       TextSize = 40,               -- حجم الخط (فاضي = تلقائي)
--       Image = "rbxassetid://...",  -- صورة اختيارية فوق الاسم
--       Pulses = 4,                  -- عدد النبضات
--       Enabled = true,
--   }, function() ... end)           -- يستدعى عند الانتهاء (اختياري)
--
--   يرجع كائن: handle:Wait() ينتظر الانتهاء | handle:Skip() يتخطى
--============================================================
local function playSplash(cfg, onDone)
	if type(onDone) ~= "function" then onDone = nil end
	cfg = cfg or {}

	local handle = { Finished = false }
	local gui

	local function finish()
		if handle.Finished then return end
		handle.Finished = true
		if gui then gui:Destroy() end
		if onDone then task.spawn(onDone) end
	end
	function handle.Wait()
		while not handle.Finished do task.wait() end
	end
	function handle.Skip()
		finish()
	end

	if cfg.Enabled == false then
		task.defer(finish)
		return handle
	end

	local oldSplash = playerGui:FindFirstChild("ProUI_Splash")
	if oldSplash then oldSplash:Destroy() end

	gui = Instance.new("ScreenGui")
	gui.Name = "ProUI_Splash"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 1000
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui

	local text     = tostring(pick(cfg, "Text", "Name") or "Rwonom hub")
	local color    = resolveColor(pick(cfg, "Color", "TextColor"), COLOR_RED)
	local bgCol    = resolveColor(pick(cfg, "BackgroundColor"), COLOR_BLACK)
	local S        = tonumber(pick(cfg, "Size", "LogoSize")) or 170
	local textSize = pick(cfg, "TextSize", "NameSize")
	local pulses   = tonumber(cfg.Pulses) or 4
	local image    = pick(cfg, "Image", "Logo")

	local font = pick(cfg, "Font") or Enum.Font.Creepster
	if type(font) == "string" then
		local ok, f = pcall(function() return Enum.Font[font] end)
		font = ok and f or Enum.Font.Creepster
	end

	local logo = Instance.new("Frame")
	logo.AnchorPoint = Vector2.new(0.5, 0.5)
	logo.Position = UDim2.new(0.5, 0, 0.5, 0)
	logo.Size = UDim2.new(0, 0, 0, 0)
	logo.BackgroundColor3 = bgCol
	logo.BackgroundTransparency = 1
	logo.Rotation = -180
	logo.ZIndex = 200
	logo.Parent = gui
	round(logo, UDim.new(0, 16))

	local img
	if image then
		img = Instance.new("ImageLabel")
		img.BackgroundTransparency = 1
		img.Image = tostring(image)
		img.ImageTransparency = 1
		img.ScaleType = Enum.ScaleType.Fit
		img.AnchorPoint = Vector2.new(0.5, 0)
		img.Position = UDim2.new(0.5, 0, 0.08, 0)
		img.Size = UDim2.new(0.5, 0, 0.5, 0)
		img.ZIndex = 201
		img.Parent = logo
	end

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Text = text
	label.Font = font
	label.TextColor3 = color
	label.TextTransparency = 1
	label.TextWrapped = true
	if image then
		label.Size = UDim2.new(1, -10, 0.34, 0)
		label.Position = UDim2.new(0, 5, 0.62, 0)
	else
		label.Size = UDim2.new(1, -10, 1, -10)
		label.Position = UDim2.new(0, 5, 0, 5)
	end
	if textSize then label.TextSize = tonumber(textSize) else label.TextScaled = true end
	label.ZIndex = 201
	label.Parent = logo

	task.spawn(function()
		tween(logo, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, S, 0, S), Rotation = 0, BackgroundTransparency = 0,
		})
		tween(label, TweenInfo.new(0.6), { TextTransparency = 0 })
		if img then tween(img, TweenInfo.new(0.6), { ImageTransparency = 0 }) end
		task.wait(0.6)
		if handle.Finished then return end

		for _ = 1, pulses do
			tween(logo, TweenInfo.new(0.3, Enum.EasingStyle.Sine), { Size = UDim2.new(0, S * 1.08, 0, S * 1.08) })
			task.wait(0.3)
			if handle.Finished then return end
			tween(logo, TweenInfo.new(0.3, Enum.EasingStyle.Sine), { Size = UDim2.new(0, S, 0, S) })
			task.wait(0.3)
			if handle.Finished then return end
		end

		tween(logo, TweenInfo.new(1, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0), Rotation = 180, BackgroundTransparency = 1,
		})
		tween(label, TweenInfo.new(0.7), { TextTransparency = 1 })
		if img then tween(img, TweenInfo.new(0.7), { ImageTransparency = 1 }) end
		task.wait(1)
		finish()
	end)

	return handle
end

