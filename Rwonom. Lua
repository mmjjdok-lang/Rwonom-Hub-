-- =====================================================================
-- [ RWONOM HUB - ULTIMATE ENGINE V5.0 ]
-- أقوى نظام واجهة روبلوكس بمقاسات دقيقة، تأثيرات مطر شفافة كثيفة، وعناصر متكاملة
-- =====================================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local RwonomHub = {}
RwonomHub.__index = RwonomHub

-- الثيمات المتاحة مع الألوان الخاصة بها
RwonomHub.Themes = {
    ["Derk"] = Color3.fromRGB(18, 18, 22),       -- أسود حديدي
    ["Crimcon"] = Color3.fromRGB(115, 10, 10),   -- أحمر قرمزي
    ["Red"] = Color3.fromRGB(210, 20, 20),       -- أحمر صريح
    ["Amder"] = Color3.fromRGB(220, 150, 0),     -- أصفر كهرماني
    ["Black"] = Color3.fromRGB(8, 8, 8)          -- أسود مطفي
}

function RwonomHub.new(config)
    local self = setmetatable({}, RwonomHub)
    self.WindowName = config.Name or "Rwonom Hub"
    self.WindowDesc = config.Description or "نظام السكربتات المتقدم"
    self.ThemeColor = RwonomHub.Themes[config.Theme] or RwonomHub.Themes["Derk"]
    self.Width = config.Width or 750
    self.Height = config.Height = config.Height or 480
    
    -- إنشاء الشاشة الرئيسية
    self.ScreenGui = Instance.new("ScreenGui")
    self.ScreenGui.Name = "RwonomHub_UltimateUI"
    self.ScreenGui.Parent = CoreGui
    self.ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    -- النافذة الرئيسية (التحكم في الحجم والمقاس)
    self.MainFrame = Instance.new("Frame")
    self.MainFrame.Name = "MainFrame"
    self.MainFrame.Parent = self.ScreenGui
    self.MainFrame.BackgroundColor3 = self.ThemeColor
    self.MainFrame.BackgroundTransparency = 0.25 -- شفافة وأنيقة
    self.MainFrame.Position = UDim2.new(0.5, -self.Width/2, 0.5, -self.Height/2)
    self.MainFrame.Size = UDim2.new(0, self.Width, 0, self.Height)
    self.MainFrame.Active = true
    self.MainFrame.Draggable = true
    self.MainFrame.ClipsDescendants = true

    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 12)
    MainCorner.Parent = self.MainFrame

    local MainStroke = Instance.new("UIStroke")
    MainStroke.Parent = self.MainFrame
    MainStroke.Color = Color3.fromRGB(255, 255, 255)
    MainStroke.Transparency = 0.8
    MainStroke.Thickness = 1.2

    -- =====================================================================
    -- نظام أنيميشن قطرات المطر الشفافة (كثيفة للغاية ومتحركة)
    -- =====================================================================
    local RainFolder = Instance.new("Folder")
    RainFolder.Name = "WaterDropsAnimation"
    RainFolder.Parent = self.MainFrame

    task.spawn(function()
        while true do
            task.spawn(function()
                for i = 1, 20 do
                    local Drop = Instance.new("Frame")
                    Drop.Size = UDim2.new(0, math.random(1, 3), 0, math.random(20, 50))
                    Drop.Position = UDim2.new(math.random(), 0, -0.2, 0)
                    Drop.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    Drop.BackgroundTransparency = math.random(45, 85) / 100
                    Drop.BorderSizePixel = 0
                    Drop.Parent = RainFolder

                    local DropCorner = Instance.new("UICorner")
                    DropCorner.CornerRadius = UDim.new(1, 0)
                    DropCorner.Parent = Drop

                    local speed = math.random(7, 14) / 10
                    local info = TweenInfo.new(speed, Enum.EasingStyle.Linear)
                    local goal = {Position = UDim2.new(Drop.Position.X.Scale, 0, 1.2, 0)}
                    
                    TweenService:Create(Drop, info, goal):Play()
                    
                    task.delay(speed, function()
                        Drop:Destroy()
                    end)
                end
            end)
            task.wait(0.06)
        end
    end)

    -- شريط العنوان العلوي
    local TopBar = Instance.new("Frame")
    TopBar.Parent = self.MainFrame
    TopBar.Size = UDim2.new(1, 0, 0, 55)
    TopBar.BackgroundTransparency = 1

    local Title = Instance.new("TextLabel")
    Title.Parent = TopBar
    Title.Position = UDim2.new(0.025, 0, 0.15, 0)
    Title.Size = UDim2.new(0, 400, 0, 22)
    Title.Font = Enum.Font.GothamBold
    Title.Text = self.WindowName
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 18
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.BackgroundTransparency = 1

    local Desc = Instance.new("TextLabel")
    Desc.Parent = TopBar
    Desc.Position = UDim2.new(0.025, 0, 0.55, 0)
    Desc.Size = UDim2.new(0, 500, 0, 16)
    Desc.Font = Enum.Font.Gotham
    Desc.Text = self.WindowDesc
    Desc.TextColor3 = Color3.fromRGB(170, 170, 170)
    Desc.TextSize = 11
    Desc.TextXAlignment = Enum.TextXAlignment.Left
    Desc.BackgroundTransparency = 1

    -- شريط التبويبات الجانبي
    self.TabHolder = Instance.new("ScrollingFrame")
    self.TabHolder.Parent = self.MainFrame
    self.TabHolder.Position = UDim2.new(0.02, 0, 0.15, 0)
    self.TabHolder.Size = UDim2.new(0, 180, 0, self.Height - 85)
    self.TabHolder.BackgroundTransparency = 0.55
    self.TabHolder.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
    self.TabHolder.BorderSizePixel = 0
    self.TabHolder.CanvasSize = UDim2.new(0, 0, 0, 0)
    self.TabHolder.ScrollBarThickness = 3

    local TabHCorner = Instance.new("UICorner")
    TabHCorner.CornerRadius = UDim.new(0, 8)
    TabHCorner.Parent = self.TabHolder

    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.Parent = self.TabHolder
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.Padding = UDim.new(0, 6)

    -- حاوية المحتوى الرئيسية
    self.ContainerHolder = Instance.new("Frame")
    self.ContainerHolder.Parent = self.MainFrame
    self.ContainerHolder.Position = UDim2.new(0.27, 0, 0.15, 0)
    self.ContainerHolder.Size = UDim2.new(0, self.Width - 215, 0, self.Height - 85)
    self.ContainerHolder.BackgroundTransparency = 0.65
    self.ContainerHolder.BackgroundColor3 = Color3.fromRGB(16, 16, 22)

    local ContCorner = Instance.new("UICorner")
    ContCorner.CornerRadius = UDim.new(0, 8)
    ContCorner.Parent = self.ContainerHolder

    return self
end

-- [ نظام التبويبات - Tab System ]
function RwonomHub:CreateTab(tabConfig)
    local TabName = tabConfig.Name or "تبويب"
    local TabIcon = tabConfig.Icon or "rbxassetid://0"

    local TabButton = Instance.new("TextButton")
    TabButton.Parent = self.TabHolder
    TabButton.Size = UDim2.new(1, 0, 0, 38)
    TabButton.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    TabButton.BackgroundTransparency = 0.4
    TabButton.Font = Enum.Font.GothamSemibold
    TabButton.Text = "       " .. TabName
    TabButton.TextColor3 = Color3.fromRGB(220, 220, 220)
    TabButton.TextSize = 12
    TabButton.TextXAlignment = Enum.TextXAlignment.Left

    local TBEnsure = Instance.new("UICorner")
    TBEnsure.CornerRadius = UDim.new(0, 6)
    TBEnsure.Parent = TabButton

    local IconImg = Instance.new("ImageLabel")
    IconImg.Parent = TabButton
    IconImg.Position = UDim2.new(0.06, 0, 0.2, 0)
    IconImg.Size = UDim2.new(0, 20, 0, 20)
    IconImg.BackgroundTransparency = 1
    IconImg.Image = TabIcon

    local TabPage = Instance.new("ScrollingFrame")
    TabPage.Parent = self.ContainerHolder
    TabPage.Size = UDim2.new(1, 0, 1, 0)
    TabPage.BackgroundTransparency = 1
    TabPage.Visible = false
    TabPage.CanvasSize = UDim2.new(0, 0, 2, 0)
    TabPage.ScrollBarThickness = 3

    local PageLayout = Instance.new("UIListLayout")
    PageLayout.Parent = TabPage
    PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    PageLayout.Padding = UDim.new(0, 8)

    TabButton.MouseButton1Click:Connect(function()
        for _, v in pairs(self.ContainerHolder:GetChildren()) do
            if v:IsA("ScrollingFrame") then v.Visible = false end
        end
        TabPage.Visible = true
    end)

    local TabAPI = {}

    -- [ نظام الأزرار - Button System ]
    function TabAPI:CreateButton(btnConfig)
        local BtnName = btnConfig.Name or "زر"
        local BtnDesc = btnConfig.Description or "وصف الزر"
        local Callback = btnConfig.Callback or function() end

        local BtnFrame = Instance.new("TextButton")
        BtnFrame.Parent = TabPage
        BtnFrame.Size = UDim2.new(0.96, 0, 0, 48)
        BtnFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        BtnFrame.BackgroundTransparency = 0.4
        BtnFrame.Text = ""

        local BCorner = Instance.new("UICorner")
        BCorner.CornerRadius = UDim.new(0, 6)
        BCorner.Parent = BtnFrame

        local Title = Instance.new("TextLabel")
        Title.Parent = BtnFrame
        Title.Position = UDim2.new(0.03, 0, 0.12, 0)
        Title.Size = UDim2.new(0.8, 0, 0, 18)
        Title.Font = Enum.Font.GothamBold
        Title.Text = BtnName
        Title.TextColor3 = Color3.fromRGB(255, 255, 255)
        Title.TextSize = 12
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.BackgroundTransparency = 1

        local Desc = Instance.new("TextLabel")
        Desc.Parent = BtnFrame
        Desc.Position = UDim2.new(0.03, 0, 0.52, 0)
        Desc.Size = UDim2.new(0.8, 0, 0, 16)
        Desc.Font = Enum.Font.Gotham
        Desc.Text = BtnDesc
        Desc.TextColor3 = Color3.fromRGB(160, 160, 160)
        Desc.TextSize = 10
        Desc.TextXAlignment = Enum.TextXAlignment.Left
        Desc.BackgroundTransparency = 1

        BtnFrame.MouseButton1Click:Connect(Callback)
    end

    -- [ نظام التوجل - Toggle System ]
    function TabAPI:CreateToggle(toggleConfig)
        local ToggleName = toggleConfig.Name or "توجل"
        local ToggleDesc = toggleConfig.Description or "وصف التوجل"
        local Callback = toggleConfig.Callback or function() end
        local Toggled = false

        local TFrame = Instance.new("Frame")
        TFrame.Parent = TabPage
        TFrame.Size = UDim2.new(0.96, 0, 0, 48)
        TFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        TFrame.BackgroundTransparency = 0.4

        local TCorner = Instance.new("UICorner")
        TCorner.CornerRadius = UDim.new(0, 6)
        TCorner.Parent = TFrame

        local Title = Instance.new("TextLabel")
        Title.Parent = TFrame
        Title.Position = UDim2.new(0.03, 0, 0.12, 0)
        Title.Size = UDim2.new(0.7, 0, 0, 18)
        Title.Font = Enum.Font.GothamBold
        Title.Text = ToggleName
        Title.TextColor3 = Color3.fromRGB(255, 255, 255)
        Title.TextSize = 12
        Title.TextXAlignment = Enum.TextXAlignment.Left
        Title.BackgroundTransparency = 1

        local Desc = Instance.new("TextLabel")
        Desc.Parent = TFrame
        Desc.Position = UDim2.new(0.03, 0, 0.52, 0)
        Desc.Size = UDim2.new(0.7, 0, 0, 16)
        Desc.Font = Enum.Font.Gotham
        Desc.Text = ToggleDesc
        Desc.TextColor3 = Color3.fromRGB(160, 160, 160)
        Desc.TextSize = 10
        Desc.TextXAlignment = Enum.TextXAlignment.Left
        Desc.BackgroundTransparency = 1

        local Switch = Instance.new("TextButton")
        Switch.Parent = TFrame
        Switch.Position = UDim2.new(0.85, 0, 0.28, 0)
        Switch.Size = UDim2.new(0, 40, 0, 20)
        Switch.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        Switch.Text = ""

        local SCorner = Instance.new("UICorner")
        SCorner.CornerRadius = UDim.new(1, 0)
        SCorner.Parent = Switch

        Switch.MouseButton1Click:Connect(function()
            Toggled = not Toggled
            Switch.BackgroundColor3 = Toggled and Color3.fromRGB(0, 220, 110) or Color3.fromRGB(60, 60, 70)
            Callback(Toggled)
        end)
    end

    -- [ نظام الملاحظات - Notes System ]
    function TabAPI:CreateNote(noteConfig)
        local NoteText = noteConfig.Text or "ملاحظة"
        local NoteColor = noteConfig.Color or Color3.fromRGB(200, 120, 0)

        local NFrame = Instance.new("Frame")
        NFrame.Parent = TabPage
        NFrame.Size = UDim2.new(0.96, 0, 0, 42)
        NFrame.BackgroundColor3 = NoteColor
        NFrame.BackgroundTransparency = 0.45

        local NCorner = Instance.new("UICorner")
        NCorner.CornerRadius = UDim.new(0, 6)
        NCorner.Parent = NFrame

        local Label = Instance.new("TextLabel")
        Label.Parent = NFrame
        Label.Position = UDim2.new(0.03, 0, 0.1, 0)
        Label.Size = UDim2.new(0.94, 0, 0.8, 0)
        Label.Font = Enum.Font.GothamSemibold
        Label.Text = NoteText
        Label.TextColor3 = Color3.fromRGB(255, 255, 255)
        Label.TextSize = 11
        Label.TextWrapped = true
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.BackgroundTransparency = 1
    end

    return TabAPI
end

-- [ نظام الإشعارات المطابق تماماً لـ WindUI ]
function RwonomHub:Notify(notifConfig)
    local TitleN = notifConfig.Title or "إشعار"
    local ContentN = notifConfig.Content or "محتوى الإشعار"
    
    local NotifFolder = self.ScreenGui:FindFirstChild("NotifFolder") or Instance.new("Folder", self.ScreenGui)
    NotifFolder.Name = "NotifFolder"

    local NFrame = Instance.new("Frame")
    NFrame.Parent = NotifFolder
    NFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    NFrame.BackgroundTransparency = 0.15
    NFrame.Position = UDim2.new(0.78, 0, 0.75, 0)
    NFrame.Size = UDim2.new(0, 240, 0, 60)

    local NCorner = Instance.new("UICorner")
    NCorner.CornerRadius = UDim.new(0, 8)
    NCorner.Parent = NFrame

    local Title = Instance.new("TextLabel")
    Title.Parent = NFrame
    Title.Position = UDim2.new(0.06, 0, 0.12, 0)
    Title.Size = UDim2.new(0.9, 0, 0, 18)
    Title.Font = Enum.Font.GothamBold
    Title.Text = TitleN
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 12
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.BackgroundTransparency = 1

    local Content = Instance.new("TextLabel")
    Content.Parent = NFrame
    Content.Position = UDim2.new(0.06, 0, 0.48, 0)
    Content.Size = UDim2.new(0.9, 0, 0, 24)
    Content.Font = Enum.Font.Gotham
    Content.Text = ContentN
    Content.TextColor3 = Color3.fromRGB(180, 180, 180)
    Content.TextSize = 10
    Content.TextXAlignment = Enum.TextXAlignment.Left
    Content.BackgroundTransparency = 1

    task.delay(3.5, function()
        NFrame:Destroy()
    end)
end

-- [ نظام زر الفتح الخارجي المخصص بالإحداثيات الخارجية لشاشة روبلوكس ]
function RwonomHub:CreateOpenButton(openConfig)
    local BtnName = openConfig.Name or "فتح الواجهة"
    local BtnSize = openConfig.Size or UDim2.new(0, 110, 0, 38)
    local BtnIcon = openConfig.Icon or "rbxassetid://0"
    local Position = openConfig.Position or UDim2.new(0.02, 0, 0.05, 0)

    local OpenBtn = Instance.new("TextButton")
    OpenBtn.Parent = self.ScreenGui
    OpenBtn.Size = BtnSize
    OpenBtn.Position = Position
    OpenBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    OpenBtn.BackgroundTransparency = 0.3
    OpenBtn.Font = Enum.Font.GothamBold
    OpenBtn.Text = "   " .. BtnName
    OpenBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    OpenBtn.TextSize = 11

    local OCorner = Instance.new("UICorner")
    OCorner.CornerRadius = UDim.new(0, 8)
    OCorner.Parent = OpenBtn

    local Icon = Instance.new("ImageLabel")
    Icon.Parent = OpenBtn
    Icon.Position = UDim2.new(0.06, 0, 0.2, 0)
    Icon.Size = UDim2.new(0, 20, 0, 20)
    Icon.BackgroundTransparency = 1
    Icon.Image = BtnIcon

    local isOpen = true
    OpenBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        self.MainFrame.Visible = isOpen
    end)
end

return RwonomHub
 
