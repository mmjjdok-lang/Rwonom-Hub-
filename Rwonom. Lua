            }, {
                New("UICorner", { CornerRadius = UDim.new(0, 6) }),
                New("UIStroke", { Color = theme, Thickness = 1, Transparency = 0.5 }),
            })
            Box.FocusLost:Connect(function()
                if xcfg.Type == "Number" then
                    Box.Text = Box.Text:gsub("[^%d%.%-]", "")
                end
                if xcfg.Callback then pcall(xcfg.Callback, Box.Text) end
            end)
            return Box
        end

        -- ------------- قائمة منسدلة (Dropdown) -------------
        function Tab:CreateDropdown(dcfg)
            dcfg = dcfg or {}
            local options = dcfg.Options or {}
            local selected = dcfg.Default or options[1] or ""

            local Row = New("Frame", { Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, ClipsDescendants = false, Parent = Content })
            local Head = New("TextButton", {
                Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = Colors.Black,
                Text = (dcfg.Name or "Dropdown") .. ": " .. tostring(selected),
                TextColor3 = Colors.White, Font = Enum.Font.Gotham, TextSize = 13, Parent = Row,
            }, {
                New("UICorner", { CornerRadius = UDim.new(0, 6) }),
                New("UIStroke", { Color = theme, Thickness = 1, Transparency = 0.5 }),
            })
            local List = New("Frame", {
                Size = UDim2.new(1, 0, 0, #options * 24), Position = UDim2.new(0, 0, 1, 4),
                BackgroundColor3 = Colors.Black, Visible = false, ZIndex = 10, Parent = Head,
            }, {
                New("UICorner", { CornerRadius = UDim.new(0, 6) }),
                New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
            })
            for _, opt in ipairs(options) do
                local OptBtn = New("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1,
                    Text = tostring(opt), TextColor3 = Colors.White, Font = Enum.Font.Gotham,
                    TextSize = 12, ZIndex = 11, Parent = List,
                })
                OptBtn.MouseButton1Click:Connect(function()
                    PlayClick()
                    selected = opt
                    Head.Text = (dcfg.Name or "Dropdown") .. ": " .. tostring(selected)
                    List.Visible = false
                    if dcfg.Callback then pcall(dcfg.Callback, opt) end
                end)
            end
            Head.MouseButton1Click:Connect(function()
                PlayClick()
                List.Visible = not List.Visible
            end)
            return { Set = function(_, v) selected = v; Head.Text = (dcfg.Name or "Dropdown") .. ": " .. tostring(v) end }
        end

        -- ------------- كلمة/عنوان داخل التبويب (Label) -------------
        function Tab:CreateLabel(text)
            return New("TextLabel", {
                Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = text or "",
                TextColor3 = theme, Font = Enum.Font.GothamBold, TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left, Parent = Content,
            })
        end

        -- ------------- منتقي الألوان (Color Picker) -------------
        function Tab:CreateColorPicker(ccfg)
            ccfg = ccfg or {}
            local current = ccfg.Default or Colors.Red

            local Row = New("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Parent = Content })
            New("TextLabel", {
                Size = UDim2.new(0.6, 0, 1, 0), BackgroundTransparency = 1,
                Text = ccfg.Name or "Color", TextColor3 = Colors.White, Font = Enum.Font.Gotham,
                TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = Row,
            })
            local Preview = New("TextButton", {
                Size = UDim2.fromOffset(50, 22), Position = UDim2.new(1, -50, 0.5, -11),
                BackgroundColor3 = current, Text = "", Parent = Row,
            }, { New("UICorner", { CornerRadius = UDim.new(0, 6) }) })

            local Overlay = New("Frame", {
                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.4,
                BackgroundColor3 = Color3.new(0, 0, 0), Visible = false, ZIndex = 60, Parent = MainFrame,
            })
            local Box = New("Frame", {
                Size = UDim2.fromOffset(220, 170), AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Colors.Black,
                ZIndex = 61, Parent = Overlay,
            }, {
                New("UICorner", { CornerRadius = UDim.new(0, 8) }),
                New("UIStroke", { Color = theme, Thickness = 1.5 }),
            })

            local SV = New("Frame", {
                Size = UDim2.fromOffset(150, 100), Position = UDim2.fromOffset(10, 10),
                BackgroundColor3 = current, ZIndex = 62, Parent = Box,
            }, {
                New("UICorner", { CornerRadius = UDim.new(0, 4) }),
                New("Frame", {
                    Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 63,
                    Name = "WhiteGrad",
                }, {
                    New("UIGradient", { Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }) }),
                    New("UICorner", { CornerRadius = UDim.new(0, 4) }),
                }),
                New("Frame", {
                    Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
                    BackgroundTransparency = 1, ZIndex = 64, Name = "BlackGrad",
                }, {
                    New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }) }),
                    New("UICorner", { CornerRadius = UDim.new(0, 4) }),
                }),
            })
            local SVCursor = New("Frame", {
                Size = UDim2.fromOffset(8, 8), AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundColor3 = Colors.White, ZIndex = 66, Parent = SV,
            }, { New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

            local HueBar = New("Frame", {
                Size = UDim2.fromOffset(16, 100), Position = UDim2.fromOffset(170, 10),
                ZIndex = 62, Parent = Box,
            }, {
                New("UICorner", { CornerRadius = UDim.new(0, 4) }),
                New("UIGradient", {
                    Rotation = 90,
                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
                        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
                        ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
                        ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
                    }),
                }),
            })
            local HueCursor = New("Frame", {
                Size = UDim2.new(1, 4, 0, 4), AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0, 0), BackgroundColor3 = Colors.White,
                ZIndex = 66, Parent = HueBar,
            })

            local HexBox = New("TextBox", {
                Size = UDim2.fromOffset(150, 22), Position = UDim2.fromOffset(10, 118),
                BackgroundColor3 = Colors.Gray, Text = "#FF0000", TextColor3 = Colors.White,
                Font = Enum.Font.Code, TextSize = 12, ZIndex = 62, Parent = Box,
            }, { New("UICorner", { CornerRadius = UDim.new(0, 4) }) })

            local hue = 0
            local function updateFromHS(h, s, v)
                hue = h
                current = Color3.fromHSV(h, s, v)
                SV.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                Preview.BackgroundColor3 = current
                HexBox.Text = string.format("#%02X%02X%02X",
                    math.floor(current.R * 255), math.floor(current.G * 255), math.floor(current.B * 255))
            end
            updateFromHS(0, 1, 1)

            MakeAxisDraggable(HueCursor, HueBar, function(rel)
                HueCursor.Position = UDim2.new(0.5, 0, rel, 0)
                local sPos = SVCursor.Position
                updateFromHS(rel, 1 - sPos.Y.Scale, 1 - sPos.Y.Scale >= 0 and (1 - 0) or 1)
            end)

            -- سحب مؤشر التشبع/الإضاءة داخل المربع (ثنائي الاتجاه)
            do
                local dragging, activeInput = false, nil
                local function update(pos)
                    local relX = math.clamp((pos.X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X, 0, 1)
                    local relY = math.clamp((pos.Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y, 0, 1)
                    SVCursor.Position = UDim2.fromScale(relX, relY)
                    updateFromHS(hue, relX, 1 - relY)
                end
                SV.InputBegan:Connect(function(input)
                    if dragging then return end
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true; activeInput = input; update(input.Position)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input == activeInput then update(input.Position) end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input == activeInput then dragging = false; activeInput = nil end
                end)
            end

            local ConfirmC = New("TextButton", {
                Size = UDim2.fromOffset(90, 24), Position = UDim2.fromOffset(10, 140),
                BackgroundColor3 = theme, Text = T("Confirm"), TextColor3 = Colors.White,
                Font = Enum.Font.GothamBold, TextSize = 12, ZIndex = 62, Parent = Box,
            }, { New("UICorner", { CornerRadius = UDim.new(0, 6) }) })
            local CancelC = New("TextButton", {
                Size = UDim2.fromOffset(90, 24), Position = UDim2.fromOffset(120, 140),
                BackgroundColor3 = Colors.Gray, Text = T("Cancel"), TextColor3 = Colors.White,
                Font = Enum.Font.GothamBold, TextSize = 12, ZIndex = 62, Parent = Box,
            }, { New("UICorner", { CornerRadius = UDim.new(0, 6) }) })

            Preview.MouseButton1Click:Connect(function()
                PlayClick()
                Overlay.Visible = true
            end)
            CancelC.MouseButton1Click:Connect(function()
                PlayClick()
                Overlay.Visible = false
            end)
            ConfirmC.MouseButton1Click:Connect(function()
                PlayClick()
                Overlay.Visible = false
                Preview.BackgroundColor3 = current
                if ccfg.Callback then pcall(ccfg.Callback, current) end
            end)

            return { Set = function(_, c3) current = c3; Preview.BackgroundColor3 = c3 end }
        end

        return Tab
    end

    return Window
end

-- ==================== شاشة الترحيب (Intro Splash) ====================
-- ملاحظة: خط "Arced" ليس خطاً رسمياً في Roblox، تم استخدام Creepster كأقرب
-- خط عريض/كلاسيكي بديل. إذا توفر خط مخصص برقم أصل (asset id) أخبرني لاستبداله.
function Library:PlayIntro(cfg)
    cfg = cfg or {}
    local logoName = cfg.Name or "Rwonom hub"
    local logoColor = cfg.Color or Colors.Red
    local onComplete = cfg.OnComplete

    local Gui = New("ScreenGui", {
        Name = "RwonomIntro", ResetOnSpawn = false, DisplayOrder = 100, Parent = PlayerGui,
    })
    local Logo = New("Frame", {
        Size = UDim2.fromOffset(0, 0), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Colors.Black,
        Rotation = 0, Parent = Gui,
    })
    local Text = New("TextLabel", {
        Size = UDim2.fromScale(0.9, 0.9), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1,
        Text = logoName, TextColor3 = logoColor, Font = Enum.Font.Creepster,
        TextScaled = true, TextTransparency = 1, Parent = Logo,
    })

    task.spawn(function()
        -- ظهور وتكبير ودوران
        Tween(Logo, { Size = UDim2.fromOffset(160, 160), Rotation = 360 }, 0.8, Enum.EasingStyle.Back)
        Tween(Text, { TextTransparency = 0 }, 0.6)
        task.wait(0.9)

        -- نبض الاسم لمدة تقريباً 2 ثانية
        local pulseEnd = tick() + 2
        while tick() < pulseEnd do
            Tween(Text, { TextSize = 46 }, 0.25)
            task.wait(0.25)
            Tween(Text, { TextSize = 36 }, 0.25)
            task.wait(0.25)
        end

        -- دوران للخلف وتصغير حتى الاختفاء (0x0)
        Tween(Logo, { Rotation = 720, Size = UDim2.fromOffset(0, 0) }, 1.0, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        Tween(Text, { TextTransparency = 1 }, 0.7)
        task.wait(1.0)

        Gui:Destroy()
        if onComplete then onComplete() end
    end)
end

return Library

