	local function hideConfirmation()
		tween(confirmOverlay, EASE_FAST, { BackgroundTransparency = 1 })
		local t = tween(confirmBox, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = UDim2.new(0, 0, 0, 0) })
		t.Completed:Connect(function() confirmOverlay.Visible = false end)
	end

